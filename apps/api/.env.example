# FastAPI service. Copy to .env for local development.
# Every variable is prefixed VEC_.

VEC_ENVIRONMENT=dev

# --- Supabase Auth ----------------------------------------------------------
# The project URL is enough for current projects: the JWKS endpoint and the
# expected issuer are derived from it.
VEC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Legacy projects sign session tokens with a shared secret instead
# (Supabase dashboard → Settings → API → JWT Secret). Set this ONLY if your
# project still uses symmetric signing, and REMOVE it once you migrate:
# leaving it configured keeps a second way to mint tokens alive long after
# anyone remembers it exists. This is a signing key, not an API key —
# anything holding it can impersonate any user. Never expose it.
# VEC_SUPABASE_JWT_SECRET=

# --- Local sign-in, development only ----------------------------------------
# Enables POST /v1/dev/session, which hands out a session for any address.
# It is a complete auth bypass. The router is not mounted in staging or
# prod, and the service refuses to boot there with this set.
VEC_DEV_AUTH_ENABLED=0

# --- Storage ----------------------------------------------------------------
VEC_STORAGE_BACKEND=local
VEC_STORAGE_LOCAL_DIR=./.storage
# Where the browser reaches this API; the local backend signs absolute
# download URLs with it. Unused when the backend is r2.
VEC_PUBLIC_API_URL=http://127.0.0.1:8000
# VEC_R2_BUCKET=
# VEC_R2_ENDPOINT_URL=
# VEC_R2_ACCESS_KEY_ID=
# VEC_R2_SECRET_ACCESS_KEY=

# --- Data -------------------------------------------------------------------
VEC_DATABASE_URL=sqlite+pysqlite:///./dev.db
VEC_REDIS_URL=redis://127.0.0.1:6379/0

# --- Secrets ----------------------------------------------------------------
# Production refuses to boot while any of these hold their dev default.
# VEC_IP_HASH_SECRET must be ROTATED DAILY: a plain hash of an IPv4 address
# is reversible by brute force in seconds.
VEC_IP_HASH_SECRET=dev-only-not-a-secret
VEC_WEBHOOK_SIGNING_SECRET=dev-only-not-a-secret
VEC_JWT_DEV_SECRET=dev-only-not-a-secret

# --- Stripe -----------------------------------------------------------------
# Test mode is enough to build and verify checkout: free, no business
# details, no bank account. Dashboard -> Developers -> API keys.
# VEC_STRIPE_SECRET_KEY=sk_test_...
#
# From `stripe listen --forward-to 127.0.0.1:8000/v1/stripe/webhook`, or
# from a webhook endpoint in the dashboard. Without it, signatures are not
# verified — which production refuses to boot without.
# VEC_STRIPE_WEBHOOK_SECRET=whsec_...
#
# Price ids, created by `python scripts/bootstrap_stripe.py`, which prints
# this line for you. Referenced by id rather than looked up by name so a
# duplicate made by hand in the dashboard can never be picked up silently.
# VEC_STRIPE_PRICES={"pack":"price_...","pro":"price_...","starter":"price_..."}

# Where Stripe returns the browser. Production refuses to boot while these
# still point at localhost.
VEC_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
VEC_CHECKOUT_CANCEL_URL=http://localhost:3000/#pricing
VEC_BILLING_PORTAL_RETURN_URL=http://localhost:3000/account
