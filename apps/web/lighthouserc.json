{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start --port 3100",
      "url": [
        "http://127.0.0.1:3100/",
        "http://127.0.0.1:3100/png-to-svg",
        "http://127.0.0.1:3100/convert-for-cricut",
        "http://127.0.0.1:3100/image-to-dxf",
        "http://127.0.0.1:3100/api"
      ],
      "numberOfRuns": 3,
      "settings": {
        "budgetPath": "./lighthouse-budget.json"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
