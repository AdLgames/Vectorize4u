# Next.js. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are compiled into the browser bundle — put nothing
# secret here. The Supabase anon key is public by design; the service-role
# key must never appear in this file.

NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Auth ----------------------------------------------------------
# Dashboard → Settings → API. Also add
#   http://localhost:3000/auth/callback
# to Authentication → URL Configuration → Redirect URLs, or the magic link
# will bounce.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Local sign-in, development only ----------------------------------------
# With no Supabase project configured, setting this to 1 signs in against
# the API's dev session route (which needs VEC_DEV_AUTH_ENABLED=1). It is
# not authentication; it exists so the signed-in flow can be run and tested.
NEXT_PUBLIC_DEV_AUTH=0
